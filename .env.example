# =============================================================================
# GENERIC .env TEMPLATE — SELENIUM 4 + REST ASSURED + MULTI-DB + APPIUM + K6
# Copy this file to `.env` and adjust only the project URLs and credentials
# =============================================================================

# 1. Active Environment: DEV | STAGE | GCP
TARGET_ENV=DEV

# 2. Selenium Browser Configuration
BROWSER=chrome
HEADLESS=false
BROWSER_RIGHT=false

# 3. Environment URLs (Web UI & REST API)
WEB_BASE_URL_DEV=http://localhost:3001
API_BASE_URL_DEV=http://localhost:3000

WEB_BASE_URL_STAGE=https://stage-app.example.com
API_BASE_URL_STAGE=https://stage-api.example.com

WEB_BASE_URL_GCP=https://app.example.com
API_BASE_URL_GCP=https://api.example.com

# 4. Default QA Test Credentials
QA_AUTH_EMAIL=qa.user@example.com
QA_AUTH_PASSWORD=ChangeMe123!

# 5. Database Engine (postgres | mysql | oracle | sqlserver | mariadb)
DB_ENGINE=postgres

# --- 5.1 DEV Database (db-classic) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- 5.2 STAGE Database (db-stage - READ-ONLY SELECT via SSH tunnel :5434) ---
DATABASE_STAGE_HOST=127.0.0.1
DATABASE_STAGE_PORT=5434
POSTGRES_STAGE_DB=app_db
POSTGRES_STAGE_USER=qa-viewer
POSTGRES_STAGE_PASSWORD=stage_readonly_pass

# --- 5.3 CLOUD / GCP Database (db-gcp via IAP tunnel :5433) ---
DATABASE_GCP_HOST=127.0.0.1
DATABASE_GCP_PORT=5433
POSTGRES_GCP_DB=app_db
POSTGRES_GCP_USER=qa_cloud_user
POSTGRES_GCP_PASSWORD=cloud_pass

# 6. Optional Mobile APK Testing Configuration (Appium / Android Emulator)
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=com.example.app.MainActivity
ANDROID_APK_PATH=
